# Copy to /etc/gpstrack/gpstrack.env and chmod 600.

# Tracker port. The CJ720 command list uses 5013 for your own server.
GPSTRACK_TCP=:5013

# Status page. Keep this on your LAN; do not port-forward it.
GPSTRACK_HTTP=:8080

# Required to send commands (including the fuel cut) and to view the page.
# Generate one with: openssl rand -hex 16
GPSTRACK_TOKEN=
